{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://schemas.vorstieg.com/fels-data/topo.schema.json",
	"title": "Fels topo document",
	"description": "Route metadata and optional 2D/3D topo geometry.",
	"type": "object",
	"required": ["routes"],
	"not": { "required": ["lineOverlays"] },
	"properties": {
		"id": { "type": "string" },
		"description": { "type": "string" },
		"tags": { "type": "array", "items": { "type": "string" } },
		"image2D": { "type": ["string", "null"] },
		"backgroundFit": { "enum": ["contain", "cover"] },
		"imageAspectRatio": { "type": "number", "exclusiveMinimum": 0 },
		"date": { "type": "string" },
		"updated": { "type": "string" },
		"author": { "type": "string" },
		"coordinates": {
			"type": "array",
			"items": { "type": "number" },
			"minItems": 3,
			"maxItems": 3
		},
		"routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
		"paths": { "$ref": "#/$defs/pathCollection" },
		"fixPoints": { "type": "array", "items": { "$ref": "#/$defs/fixPoint" } },
		"outlines": { "type": "array", "items": { "$ref": "#/$defs/outline" } },
		"textLabels": { "type": "array", "items": { "$ref": "#/$defs/textLabel" } }
	},
	"additionalProperties": true,
	"$defs": {
		"point2D": {
			"type": "array",
			"items": { "type": "number", "minimum": 0, "maximum": 1 },
			"minItems": 2,
			"maxItems": 2
		},
		"point3D": {
			"type": "array",
			"items": { "type": "number" },
			"minItems": 3,
			"maxItems": 3
		},
		"path2D": { "type": "array", "items": { "$ref": "#/$defs/point2D" }, "minItems": 2 },
		"path3D": { "type": "array", "items": { "$ref": "#/$defs/point3D" }, "minItems": 2 },
		"pathCollection": {
			"type": "object",
			"required": ["type", "features"],
			"properties": {
				"type": { "const": "FeatureCollection" },
				"features": { "type": "array", "items": { "$ref": "#/$defs/pathFeature" } }
			},
			"additionalProperties": true
		},
		"pathFeature": {
			"type": "object",
			"required": ["type", "geometry"],
			"properties": {
				"type": { "const": "Feature" },
				"id": { "type": ["string", "number"] },
				"properties": {
					"type": "object",
					"properties": {
						"name": { "type": "string" },
						"role": { "type": "string" },
						"label": { "type": "string" },
						"routeType": { "type": "string" }
					},
					"additionalProperties": true
				},
				"geometry": {
					"type": "object",
					"required": ["type", "coordinates"],
					"properties": {
						"type": { "const": "LineString" },
						"coordinates": {
							"type": "array",
							"minItems": 2,
							"items": { "$ref": "#/$defs/point3D" }
						}
					},
					"additionalProperties": true
				}
			},
			"additionalProperties": true
		},
		"grade": {
			"oneOf": [
				{
					"type": "object",
					"required": ["scale", "value", "standardizedValue"],
					"properties": {
						"scale": { "type": "string" },
						"value": { "type": "string" },
						"standardizedValue": { "type": "string" }
					},
					"additionalProperties": false
				},
				{ "type": "null" }
			]
		},
		"pathRef": {
			"type": "object",
			"required": ["pathId"],
			"properties": {
				"pathId": { "type": ["string", "number"] },
				"role": { "type": "string" },
				"label": { "type": "string" }
			},
			"additionalProperties": true
		},
		"curve": {
			"type": "object",
			"properties": {
				"enabled": { "type": "boolean" },
				"tension": { "type": "number" }
			},
			"additionalProperties": true
		},
		"climbingLine": {
			"type": "object",
			"required": ["id"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"grade": { "$ref": "#/$defs/grade" },
				"length": { "type": "number", "minimum": 0 },
				"lineStyle": { "type": "string" },
				"curve": { "$ref": "#/$defs/curve" },
				"labelOffset2D": { "$ref": "#/$defs/point2D" },
				"points2D": { "$ref": "#/$defs/path2D" },
				"points3D": { "$ref": "#/$defs/path3D" }
			},
			"additionalProperties": true
		},
		"route": {
			"allOf": [
				{ "$ref": "#/$defs/climbingLine" },
				{
					"type": "object",
					"properties": {
						"name": { "type": "string" },
						"type": { "type": "string" },
						"description": { "type": "string" },
						"tags": { "type": "array", "items": { "type": "string" } },
						"orientation3D": { "$ref": "#/$defs/point3D" },
						"boltAmount": { "type": "number", "minimum": 0 },
						"pitches": { "type": "array", "items": { "$ref": "#/$defs/pitch" } },
						"variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
						"fixPoints": { "type": "array", "items": { "type": ["string", "number"] } },
						"assets": { "type": "object" },
						"pathRefs": { "type": "array", "items": { "$ref": "#/$defs/pathRef" } }
					},
					"additionalProperties": true
				}
			]
		},
		"pitch": {
			"allOf": [
				{ "$ref": "#/$defs/climbingLine" },
				{
					"type": "object",
					"required": ["pitchNumber"],
					"properties": {
						"pitchNumber": { "type": "integer", "minimum": 1 }
					},
					"additionalProperties": true
				}
			]
		},
		"variant": {
			"allOf": [
				{ "$ref": "#/$defs/climbingLine" },
				{
					"type": "object",
					"properties": {
						"name": { "type": "string" }
					},
					"additionalProperties": true
				}
			]
		},
		"fixPoint": {
			"type": "object",
			"required": ["id", "type"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"type": { "type": "string" },
				"position2D": { "$ref": "#/$defs/point2D" },
				"position3D": { "$ref": "#/$defs/point3D" },
				"rotation2D": { "type": "number" },
				"scale2D": { "type": "number" },
				"scaleX2D": { "type": "number" },
				"scaleY2D": { "type": "number" }
			},
			"additionalProperties": true
		},
		"outline": {
			"type": "object",
			"required": ["id"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"points2D": { "$ref": "#/$defs/path2D" },
				"lineStyle": { "type": "string" },
				"shape": {
					"type": ["object", "null"],
					"not": { "type": "object", "required": ["points2D"] },
					"properties": {
						"type": { "type": "string" },
						"preset": { "type": "string" },
						"semantic": { "type": "object" },
						"start2D": { "$ref": "#/$defs/point2D" },
						"end2D": { "$ref": "#/$defs/point2D" },
						"center2D": { "$ref": "#/$defs/point2D" },
						"radius2D": { "type": "number" },
						"segments": { "type": "integer" },
						"fromCenter": { "type": "boolean" },
						"square": { "type": "boolean" }
					},
					"additionalProperties": true
				},
				"curve": { "$ref": "#/$defs/curve" },
				"fillColor": { "type": ["string", "null"] },
				"fillOpacity": { "type": "number" },
				"closed": { "type": "boolean" }
			},
			"additionalProperties": true
		},
		"textLabel": {
			"type": "object",
			"required": ["id", "text"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"text": { "type": "string" },
				"position2D": { "$ref": "#/$defs/point2D" },
				"position3D": { "$ref": "#/$defs/point3D" },
				"rotation2D": { "type": "number" },
				"fontSize2D": { "type": "number" },
				"color": { "type": "string" },
				"fontWeight": { "type": ["string", "number"] },
				"textAlign2D": { "enum": ["left", "center", "right"] }
			},
			"additionalProperties": true
		}
	}
}
