NODE_ENV=development
PORT=3001
DATA_DIR=/srv/felslager/content
# Absolute persistent path outside content and the deployment checkout.
AUTH_DATABASE_PATH=/srv/felslager-auth/auth.sqlite
# Generate independently (e.g. openssl rand -base64 48). No shared Basic credentials.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001/api/auth
STUDIO_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
# Empty means no proxy trust. Otherwise explicit IPs/CIDRs, never wildcard/true.
TRUST_PROXY=
# Production: NODE_ENV=production and HTTPS lager/studio URLs.

# Optional private review storage; defaults to reviews/ beside the auth database.
# Must remain outside DATA_DIR and the deployment checkout.
# REVIEW_DIR=/srv/felslager-auth/reviews

# Private work files and immutable processing results. Workers mount this
# directory read-write at the API's same absolute path. Nothing publishes here.
PROCESSING_DIR=/srv/felslager-auth/processing
BOLT_WORKER_TOKEN=
PREFECT_API_URL=http://127.0.0.1:4200/api

# Original captures live in a separate private tree, keyed by capture ID.
# Workers mount this directory read-only at the same absolute path as the API.
# Explicit absolute path required by worker Compose bind mounts.
CAPTURE_DIR=/srv/felslager-sources
# Defaults: 20 GiB per uploaded file and 100 GiB per capture.
CAPTURE_MAX_FILE_BYTES=21474836480
CAPTURE_MAX_DATASET_BYTES=107374182400

# Worker-only Docker Compose settings. The API runs on the host with npm start.
# Containers access the host API through Docker's host gateway (not localhost).
# Change the port here too if the host API uses a different PORT.
FELSLAGER_JOBS_URL=http://host.docker.internal:3001/api/processing
# Prefect dashboard binds to localhost. Workers use the internal Compose API URL.
PREFECT_PORT=4200
# Extracted official Meshroom Linux distribution (read-only runtime mount).
MESHROOM_INSTALL_DIR=/opt/Meshroom-2025.1.0
# Directory outside Git containing the licensed RealityScan Linux .deb installer.
REALITYSCAN_INSTALLER_DIR=/opt/felslager-installers/realityscan
# Match the host's video/render group IDs for RealityScan /dev/dri access.
VIDEO_GID=44
RENDER_GID=109
# Optional dedicated disk for worker engine state (workers/compose.storage.yaml).
# Create realityscan-state and nodeodm-data below it, owned by UID 1000.
# FELSLAGER_STORAGE_DIR=/srv/felslager-storage
# To place captures or processing on another disk, change CAPTURE_DIR or PROCESSING_DIR.
