# Local workers: launch one reconstruction process per enabled engine, plus detection.
FELSLAGER_JOBS_URL=http://127.0.0.1:3001/api/processing
BOLT_WORKER_TOKEN=
NODEODM_URL=http://127.0.0.1:3000
BOLT_MODEL_PATH=models/bolt_detector_v3_yolo26s.pt
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_SERVER_ALLOW_EPHEMERAL_MODE=false
PREFECT_LOGGING_EXTRA_LOGGERS=felslager-worker

# Meshroom 2025.1 installation on the worker host (includes meshroom_batch).
MESHROOM_HOME=/opt/Meshroom-2025.1.0

# RealityScan Linux CLI and export settings (see README)
REALITYSCAN_CLI=/opt/realityscan/bin/realityscan-cli
REALITYSCAN_MODEL_PARAMS=presets/realityscan/model.xml
REALITYSCAN_REGISTRATION_PARAMS=presets/realityscan/registration.xml
